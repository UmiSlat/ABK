+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Functional reconstruction from supplied stock BTF and arm64 instructions.
+ * This is a review candidate, not the unpublished Xiaomi source.
+ */
+#include <linux/fs.h>
+#include <linux/f2fs_fs.h>
+#include <linux/capability.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+
+#include "f2fs.h"
+
+#define VIP_CAPACITY 1000U
+#define VIP_QUEUE_SIZE (VIP_CAPACITY * 2)
+#define VIP_EMPTY ((nid_t)~0U)
+
+static struct f2fs_vip_manager *vip_manager(struct f2fs_sb_info *sbi)
+{
+	struct f2fs_nm_info *nm = NM_I(sbi);
+
+	return nm ? &nm->vip : NULL;
+}
+
+static bool vip_ready(struct f2fs_vip_manager *vip)
+{
+	return vip && vip->sorted && vip->unsorted;
+}
+
+/* Caller holds vip->lock. Return either the match or insertion position. */
+static unsigned int vip_search(struct f2fs_vip_manager *vip, nid_t ino,
+			      bool *found)
+{
+	unsigned int low = 0, high = vip->count;
+
+	while (low < high) {
+		unsigned int mid = low + (high - low) / 2;
+
+		if (vip->sorted[mid].ino < ino)
+			low = mid + 1;
+		else
+			high = mid;
+	}
+	*found = low < vip->count && vip->sorted[low].ino == ino;
+	return low;
+}
+
+/* No inode pointers are retained, so reclaiming an inode cannot dangle one. */
+static int vip_remove_locked(struct f2fs_vip_manager *vip, nid_t ino)
+{
+	unsigned int pos, slot;
+	bool found;
+
+	pos = vip_search(vip, ino, &found);
+	if (!found)
+		return -ENOENT;
+	slot = vip->sorted[pos].unsorted_idx;
+	if (slot >= vip->unsorted_tail || vip->unsorted[slot].ino != ino)
+		return -EFAULT;
+	vip->unsorted[slot].ino = VIP_EMPTY;
+	memmove(&vip->sorted[pos], &vip->sorted[pos + 1],
+		(vip->count - pos - 1) * sizeof(*vip->sorted));
+	vip->count--;
+	while (vip->unsorted_head < vip->unsorted_tail &&
+	       vip->unsorted[vip->unsorted_head].ino == VIP_EMPTY)
+		vip->unsorted_head++;
+	return 0;
+}
+
+static int vip_compact_locked(struct f2fs_vip_manager *vip)
+{
+	unsigned int read, write = 0, pos;
+	bool found;
+
+	for (read = vip->unsorted_head; read < vip->unsorted_tail; read++) {
+		nid_t ino = vip->unsorted[read].ino;
+
+		if (ino == VIP_EMPTY)
+			continue;
+		pos = vip_search(vip, ino, &found);
+		if (!found)
+			return -EFAULT;
+		vip->unsorted[write].ino = ino;
+		vip->sorted[pos].unsorted_idx = write++;
+	}
+	vip->unsorted_head = 0;
+	vip->unsorted_tail = write;
+	return write == vip->count ? 0 : -EFAULT;
+}
+
+static int vip_insert_locked(struct f2fs_vip_manager *vip, nid_t ino)
+{
+	unsigned int pos;
+	bool found;
+	int ret;
+
+	vip_search(vip, ino, &found);
+	if (found)
+		return -EEXIST;
+	if (vip->count == vip->capacity) {
+		if (vip->unsorted_head >= vip->unsorted_tail)
+			return -EFAULT;
+		ret = vip_remove_locked(vip,
+			vip->unsorted[vip->unsorted_head].ino);
+		if (ret)
+			return ret;
+	}
+	if (vip->unsorted_tail == vip->unsorted_buf_size) {
+		ret = vip_compact_locked(vip);
+		if (ret)
+			return ret;
+	}
+	pos = vip_search(vip, ino, &found);
+	memmove(&vip->sorted[pos + 1], &vip->sorted[pos],
+		(vip->count - pos) * sizeof(*vip->sorted));
+	vip->sorted[pos].ino = ino;
+	vip->sorted[pos].unsorted_idx = vip->unsorted_tail;
+	vip->unsorted[vip->unsorted_tail++].ino = ino;
+	vip->count++;
+	return 0;
+}
+
+void f2fs_vip_init(struct f2fs_sb_info *sbi)
+{
+	struct f2fs_vip_manager *vip = vip_manager(sbi);
+	u64 bytes = (u64)le32_to_cpu(F2FS_RAW_SUPER(sbi)->segment_count) <<
+		(sbi->log_blocksize + sbi->log_blocks_per_seg);
+
+	static_assert(sizeof(*vip) == 48);
+	static_assert(FI_VIP_FILE == 38);
+	if (!vip)
+		return;
+	spin_lock_init(&vip->lock);
+	/* Match the observed stock >30 GiB volume filter, not a path guess. */
+	if (bytes <= (30ULL << 30))
+		return;
+	vip->sorted = kvcalloc(VIP_CAPACITY, sizeof(*vip->sorted), GFP_KERNEL);
+	vip->unsorted = kvmalloc_array(VIP_QUEUE_SIZE,
+				      sizeof(*vip->unsorted), GFP_KERNEL);
+	if (!vip_ready(vip)) {
+		kvfree(vip->sorted);
+		kvfree(vip->unsorted);
+		vip->sorted = NULL;
+		vip->unsorted = NULL;
+		return; /* An optional optimization must not fail the mount. */
+	}
+	memset(vip->unsorted, 0xff, VIP_QUEUE_SIZE * sizeof(*vip->unsorted));
+	vip->capacity = VIP_CAPACITY;
+	vip->unsorted_buf_size = VIP_QUEUE_SIZE;
+	/* kzalloc leaves count/head/tail/enabled at zero. */
+}
+
+void f2fs_vip_destroy(struct f2fs_sb_info *sbi)
+{
+	struct f2fs_vip_manager *vip = vip_manager(sbi);
+
+	/* Called in node-manager teardown after filesystem users are quiesced. */
+	if (!vip)
+		return;
+	kvfree(vip->sorted);
+	kvfree(vip->unsorted);
+	memset(vip, 0, sizeof(*vip));
+}
+
+void f2fs_vip_restore(struct inode *inode)
+{
+	struct f2fs_vip_manager *vip = vip_manager(F2FS_I_SB(inode));
+	bool found;
+
+	if (!S_ISREG(inode->i_mode) || !vip_ready(vip) || !READ_ONCE(vip->enabled))
+		return;
+	spin_lock(&vip->lock);
+	vip_search(vip, inode->i_ino, &found);
+	if (found)
+		set_inode_flag(inode, FI_VIP_FILE);
+	spin_unlock(&vip->lock);
+}
+
+void f2fs_vip_unlink(struct inode *inode)
+{
+	struct f2fs_vip_manager *vip = vip_manager(F2FS_I_SB(inode));
+
+	if (!vip_ready(vip))
+		return;
+	/* Remove even while disabled, including rename-overwrite final eviction. */
+	spin_lock(&vip->lock);
+	vip_remove_locked(vip, inode->i_ino);
+	clear_inode_flag(inode, FI_VIP_FILE);
+	spin_unlock(&vip->lock);
+}
+
+bool f2fs_is_vip_file(struct inode *inode)
+{
+	struct f2fs_vip_manager *vip = vip_manager(F2FS_I_SB(inode));
+	bool found;
+
+	if (!vip_ready(vip) || !READ_ONCE(vip->enabled) ||
+	    !is_inode_flag_set(inode, FI_VIP_FILE))
+		return false;
+	/* A live inode can outlast FIFO removal; the table remains authoritative. */
+	spin_lock(&vip->lock);
+	vip_search(vip, inode->i_ino, &found);
+	spin_unlock(&vip->lock);
+	return found;
+}
+
+long f2fs_ioc_set_vip_file(struct file *file, unsigned long arg)
+{
+	struct inode *inode = file_inode(file);
+	struct f2fs_vip_manager *vip = vip_manager(F2FS_I_SB(inode));
+	unsigned int value;
+	int ret;
+
+	if (get_user(value, (unsigned int __user *)arg))
+		return -EFAULT;
+	if (!S_ISREG(inode->i_mode))
+		return -EINVAL;
+	/* Global RT registry mutations require explicit scheduling privilege. */
+	if (!capable(CAP_SYS_NICE))
+		return -EPERM;
+	if (!vip_ready(vip) || !READ_ONCE(vip->enabled))
+		return -EOPNOTSUPP;
+	spin_lock(&vip->lock);
+	ret = value ? vip_insert_locked(vip, inode->i_ino) :
+		vip_remove_locked(vip, inode->i_ino);
+	if (!ret) {
+		if (value)
+			set_inode_flag(inode, FI_VIP_FILE);
+		else
+			clear_inode_flag(inode, FI_VIP_FILE);
+	}
+	spin_unlock(&vip->lock);
+	return ret;
+}
